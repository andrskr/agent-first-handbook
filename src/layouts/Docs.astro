---
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from 'emdash/ui';
import { createPublicPageContext } from 'emdash/page';
import { markdownPath } from '../lib/chapter-paths';
import type { Chapter } from '../lib/chapters';
import type { MarkdownHeading } from '../lib/markdown';
import { groupBySection } from '../lib/order';
import '../styles/fonts.css';
import '../styles/docs.css';

interface Props {
  title: string;
  description: string;
  chapters: Chapter[];
  /** The chapter on show, or null on the not-found page. */
  current: Chapter | null;
  headings?: MarkdownHeading[];
}

const siteName = 'Agent-first Operating Model';
const { title, description, chapters, current, headings = [] } = Astro.props;
const page = createPublicPageContext({
  Astro,
  kind: 'custom',
  pageType: 'website',
  title: `${title} | ${siteName}`,
  pageTitle: title,
  siteName,
  description,
  canonical: current ? `${Astro.url.origin}${current.path}` : undefined,
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        var theme;
        try { theme = localStorage.getItem('theme'); } catch (error) {}
        if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{title} | {siteName}</title>
    {!current && <meta name="robots" content="noindex" />}
    <link rel="preload" href="/fonts/source-serif.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {current && <link rel="alternate" type="text/markdown" href={markdownPath(current.path)} />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Handbook index for agents" />
    <EmDashHead page={page} />
  </head>
  <body data-menu="closed">
    <EmDashBodyStart page={page} />
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="topbar">
      <button type="button" class="icon-button menu-button" aria-controls="sidebar" aria-expanded="false" aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 5.5h14M3 10h14M3 14.5h14" /></svg>
      </button>
      <a class="brand" href="/"><strong>{siteName}</strong><span>Handbook</span></a>
      <div class="search" role="search">
        <input id="search-input" type="search" placeholder="Search" aria-label="Search the handbook" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" />
        <kbd aria-hidden="true">/</kbd>
        <div id="search-results" role="listbox" aria-label="Search results" hidden></div>
      </div>
      {current && <a class="markdown-link" href={markdownPath(current.path)}>Markdown</a>}
      <button type="button" class="icon-button theme-toggle" aria-label="Toggle light and dark theme">
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M16.5 11.6A6.8 6.8 0 0 1 8.4 3.5a6.8 6.8 0 1 0 8.1 8.1Z" /></svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="3.4" /><path d="M10 2.5v1.8M10 15.7v1.8M2.5 10h1.8M15.7 10h1.8M4.7 4.7 6 6M14 14l1.3 1.3M4.7 15.3 6 14M14 6l1.3-1.3" /></svg>
      </button>
    </header>
    <div class="backdrop"></div>
    <div class="shell">
      <nav id="sidebar" class="sidebar" aria-label="Handbook pages">
        {groupBySection(chapters).map(({ section, chapters: group }) => (
          <div class="group">
            <p class="group-title">{section}</p>
            <ul>
              {group.map((chapter) => (
                <li><a href={chapter.path} aria-current={chapter.path === current?.path ? 'page' : undefined}>{chapter.title}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
      <main id="content" class="content" tabindex="-1">
        <article class="article"><slot /></article>
        <footer class="site-footer">
          <a href="https://github.com/andrskr/agent-first-handbook">Source on GitHub</a>
          <span>Draws on ideas from the Amp <a href="https://ampcode.com/chronicle">blog</a> and <a href="https://www.youtube.com/@AmpCodeInc">YouTube channel</a></span>
        </footer>
      </main>
      {headings.length > 0 && (
        <nav class="toc" aria-label="On this page">
          <p class="toc-title">On this page</p>
          <ul>
            {headings.map((heading) => (
              <li class={`level-${heading.level}`}><a href={`#${heading.id}`}>{heading.text}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </div>
    <EmDashBodyEnd page={page} />
    <script>
      import '../scripts/search';

      const body = document.body;
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
      const setMenu = (open: boolean) => {
        body.dataset.menu = open ? 'open' : 'closed';
        menuButton?.setAttribute('aria-expanded', String(open));
      };
      menuButton?.addEventListener('click', () => setMenu(body.dataset.menu !== 'open'));
      document.querySelector('.backdrop')?.addEventListener('click', () => setMenu(false));
      document.querySelector('#sidebar')?.addEventListener('click', (event) => {
        if ((event.target as Element).closest('a')) setMenu(false);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && body.dataset.menu === 'open') {
          setMenu(false);
          menuButton?.focus();
        }
      });

      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });

      // Mark the "On this page" entry for the last heading that has scrolled past the top bar.
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
      const targets = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));
      let pending = false;
      const update = () => {
        pending = false;
        const line = (document.querySelector('.topbar') as HTMLElement).offsetHeight + 24;
        const bottom = window.scrollY > 0 && window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
        let current = bottom ? links.length - 1 : -1;
        if (!bottom) targets.forEach((target, index) => { if (target && target.getBoundingClientRect().top <= line) current = index; });
        links.forEach((link, index) => (index === current ? link.setAttribute('aria-current', 'true') : link.removeAttribute('aria-current')));
      };
      if (links.length) {
        const schedule = () => { if (!pending) { pending = true; requestAnimationFrame(update); } };
        document.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule);
        update();
      }
    </script>
  </body>
</html>
